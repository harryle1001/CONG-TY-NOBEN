# Sao chép thành .env rồi điền. KHÔNG commit file .env.

# ===== CHẾ ĐỘ NHÁP =====
# true (mặc định): không gửi gì ra ngoài, chỉ ghi câu trả lời dự kiến vào data/ để duyệt.
# Chỉ chủ studio tự đổi thành false khi đã duyệt xong và muốn gửi thật.
DRY_RUN=true

PORT=8787

# ===== Claude API =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ===== Meta (Facebook Page, Messenger, Instagram) =====
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
IG_USER_ID=
META_GRAPH_VERSION=v21.0

# ===== Zalo OA =====
ZALO_APP_ID=
ZALO_OA_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=

# ===== Google Sheets (service account) — để trống thì ghi file CSV trong data/ =====
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=KhachTiemNang
GOOGLE_SA_CLIENT_EMAIL=
# Dán private_key của service account, giữ nguyên các ký tự \n, đặt trong dấu ngoặc kép
GOOGLE_SA_PRIVATE_KEY=

# ===== Giới hạn & chống trùng =====
RATE_PER_SENDER_PER_MIN=4
RATE_GLOBAL_PER_MIN=60
DEDUPE_TTL_HOURS=72
