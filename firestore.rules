rules_version = '2';
// Luật bảo mật cho HA QUAN RUBIK SCHOOL 2D (dán vào Firebase Console → Firestore Database → Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me(id) { return signed() && request.auth.uid == id; }

    // Tài khoản và tiến độ: chỉ chính chủ đọc, ghi
    match /data/users/{uid}/{doc} { allow read, write: if me(uid); }

    // Bảng xếp hạng, cửa hàng, nhà, hộp thư, điểm thi: ai đăng nhập cũng xem, chỉ chính chủ sửa
    match /board/{uid} { allow read: if signed(); allow write: if me(uid); }
    match /shops/{uid} { allow read: if signed(); allow write: if me(uid); }
    match /homes/{uid} { allow read: if signed(); allow write: if me(uid); }
    match /mail/{uid}  { allow read: if signed(); allow write: if me(uid); }
    match /lb/{uid}    { allow read: if signed(); allow write: if me(uid); }

    // Tiến độ học: chỉ chính chủ
    match /learn/{uid} { allow read, write: if me(uid); }

    // Phòng cờ vua online theo mã phòng
    match /chess/{code} { allow read, write: if signed(); }

    // Ai đang online
    match /rt_presence/{peer} {
      allow read: if signed();
      allow create, update: if signed() && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signed() && (resource.data.uid == request.auth.uid
        || resource.data.at < request.time.toMillis() - 86400000);
    }

    // Tin nhắn, lời mời, nước đi online
    match /rt_events/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }
  }
}
