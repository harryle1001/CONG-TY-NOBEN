# Copy to .env (chmod 600). Never commit .env. Keys stay on the server; the browser never sees them.
# One model is enough. Anthropic is used first if both are set.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# JARVIS_LLM=anthropic|gemini|none

# Voice (ElevenLabs: speech in = Scribe, speech out = TTS). Without it Jarvis is text-only.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9   # "Daniel", British. Swap for any voice ID from your ElevenLabs library.
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2  # eleven_flash_v2_5 is cheaper and faster, slightly less polished

# 1 = invented demo data (default), 0 = your real folders
JARVIS_DEMO=1
# Real mode only (separate paths with ':' on Mac/Linux, ';' on Windows)
JARVIS_SOURCES=
JARVIS_INBOX=        # Maildir folder (new/ = unread) or a folder of .eml files
JARVIS_CALENDAR=     # an .ics file exported from Google Calendar / Outlook
