# Copy to .env, fill in, then: chmod 600 .env   (.env is gitignored)
JARVIS_DEMO=1                     # 1 = invented demo data (default). 0 = your real folders
JARVIS_SOURCES=                   # real mode: folders separated by ":" (Windows ";")
ANTHROPIC_API_KEY=                # the brain (Claude). Empty = keyword routing only
ELEVENLABS_API_KEY=               # voice in + out
ELEVEN_VOICE_ID=onwK4e9ZLuTAKqWW03F9   # "Daniel", British
JARVIS_WEB=0                      # 1 = allow paid web searches
JARVIS_IMAP_HOST=imap.gmail.com   # inbox, read-only (Gmail: use an App Password)
JARVIS_IMAP_USER=
JARVIS_IMAP_PASSWORD=
JARVIS_ICS=                       # calendar: Google Calendar "secret address in iCal format"
